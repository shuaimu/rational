{
  "compilerOptions": {
    "target": "ES2023",
    "lib": [
      "ES2023",
      "DOM",
      "DOM.Iterable"
    ],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "noImplicitOverride": true,
    "useUnknownInCatchVariables": true,
    "verbatimModuleSyntax": true,
    "isolatedModules": true,
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "skipLibCheck": true,
    "noEmit": true,
    "types": [
      "node",
      "@playwright/test"
    ],
    "paths": {
      "@mako-cloud/ui": [
        "./src/kit/index.ts"
      ],
      "@mako-cloud/ui/*": [
        "./src/kit/*"
      ]
    }
  },
  "include": [
    "playwright.config.ts",
    "vite.config.ts",
    "test-support/**/*.d.ts",
    "test/**/*.ts"
  ]
}
