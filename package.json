{
  "name": "rational",
  "version": "0.1.0",
  "description": "A household money manager with no backend server of its own",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/shuaimu/rational.git"
  },
  "homepage": "https://shuaimu.github.io/rational/",
  "bugs": {
    "url": "https://github.com/shuaimu/rational/issues"
  },
  "type": "module",
  "scripts": {
    "bootstrap": "node scripts/bootstrap.mjs",
    "build": "tsc -b && vite build",
    "dev": "vite --host 127.0.0.1",
    "seed": "node scripts/seed.mjs",
    "test:browser": "playwright test",
    "test:unit": "npm run build && node --test test-unit/*.test.mjs",
    "typecheck": "tsc -b --pretty false && tsc -p tsconfig.test.json --pretty false"
  },
  "dependencies": {
    "@mako-cloud/rxdb": "github:makodb/mako-rxdb#v0.1.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "rxdb": "17.4.0",
    "rxjs": "7.8.2"
  },
  "devDependencies": {
    "@playwright/test": "1.62.1",
    "@types/react": "^19.1.9",
    "@types/react-dom": "^19.1.7",
    "typescript": "~5.9.3",
    "vite": "^7.3.6"
  },
  "engines": {
    "node": ">=20.19.0"
  }
}
