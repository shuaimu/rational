{
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "generation",
    "state",
    "jobId",
    "latest",
    "historicalDigest",
    "historicalCount",
    "updatedAt"
  ],
  "properties": {
    "id": {
      "type": "string",
      "enum": [
        "cache"
      ],
      "maxLength": 32
    },
    "generation": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "state": {
      "type": "string",
      "enum": [
        "ready",
        "updating"
      ]
    },
    "jobId": {
      "type": [
        "string",
        "null"
      ],
      "maxLength": 66
    },
    "latest": {
      "type": "array",
      "maxItems": 10000,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "symbol",
          "latest_price_date",
          "latest_price",
          "source",
          "fetched_at"
        ],
        "properties": {
          "symbol": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          },
          "latest_price_date": {
            "type": "string",
            "maxLength": 10,
            "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
          },
          "latest_price": {
            "type": "number"
          },
          "source": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          },
          "fetched_at": {
            "type": [
              "string",
              "null"
            ],
            "maxLength": 64
          }
        }
      }
    },
    "historicalDigest": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$",
      "maxLength": 64
    },
    "historicalCount": {
      "type": "integer",
      "minimum": 0,
      "maximum": 500000
    },
    "updatedAt": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    }
  }
}
