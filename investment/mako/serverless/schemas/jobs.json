{
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "commandId",
    "kind",
    "input",
    "inputHash",
    "state",
    "generation",
    "attempt",
    "createdAt",
    "updatedAt",
    "dueAt",
    "leaseUntil",
    "worker",
    "checkpoint",
    "cancelRequested",
    "result",
    "error",
    "artifactsExpireAt"
