{
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "jobId",
    "kind",
    "digest",
    "bytes"
  ],
  "properties": {
    "id": {
      "type": "string",
      "maxLength": 66,
      "pattern": "^[ab]_[a-f0-9]{64}$"
    },
    "jobId": {
      "type": "string",
      "maxLength": 66,
      "pattern": "^j_[a-f0-9]{64}$"
    },
    "kind": {
      "type": "string",
      "enum": [
        "manifest",
        "chunk"
      ]
    },
    "digest": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$",
      "maxLength": 64
    },
    "bytes": {
      "type": "integer",
      "minimum": 1,
      "maximum": 67108864
    },
    "payload": {
      "type": "string",
      "maxLength": 349528
    },
    "chunks": {
      "type": "array",
      "maxItems": 256,
      "items": {
        "type": "string",
        "maxLength": 66,
        "pattern": "^b_[a-f0-9]{64}$"
      }
    }
  }
}
