{
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "kind",
    "bytes",
    "digest"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[uk]_[a-f0-9]{64}$",
      "maxLength": 66
    },
    "kind": {
      "type": "string",
      "enum": [
        "upload",
        "chunk"
      ]
    },
    "commandId": {
      "type": "string",
      "maxLength": 128
    },
    "bytes": {
      "type": "integer",
      "minimum": 1,
      "maximum": 52428800
    },
    "digest": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$",
      "maxLength": 64
    },
    "chunkBytes": {
      "type": "integer",
      "minimum": 1,
      "maximum": 262144
    },
    "chunks": {
      "type": "integer",
      "minimum": 1,
      "maximum": 200
    },
    "createdAt": {
      "type": "integer",
      "minimum": 0
    },
    "state": {
      "type": "string",
      "enum": [
        "uploading",
        "sealed",
        "bound",
        "expired"
      ]
    },
    "uploadId": {
      "type": "string",
      "maxLength": 66
    },
    "index": {
      "type": "integer",
      "minimum": 0,
      "maximum": 199
    },
    "payload": {
      "type": "string",
      "maxLength": 349528
    },
    "expiresAt": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "jobId": {
      "type": "string",
      "pattern": "^j_[a-f0-9]{64}$",
      "maxLength": 66
    }
  }
}
