{
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "row"
  ],
  "properties": {
    "id": {
      "type": "string",
      "minLength": 66,
      "maxLength": 66,
      "pattern": "^r_[0-9a-f]{64}$"
    },
    "row": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "symbol",
        "latest_price_date",
        "latest_price",
        "source",
        "fetched_at"
      ],
      "properties": {
        "symbol": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "latest_price_date": {
          "type": "string",
          "maxLength": 10,
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
        },
        "latest_price": {
          "type": "number"
        },
        "source": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "fetched_at": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 64
        }
      }
    }
  }
}
